{
  "name": "yuanyanyao-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm type-check && next build",
    "start": "next start",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint src",
    "type-check": "tsc --noEmit",
    "check-all": "pnpm run type-check && pnpm run lint && pnpm run build",
    "postbuild": "next-sitemap",
    "test:smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@next/third-parties": "15.5.28",
    "fuse.js": "^7.5.0",
    "next": "15.5.28",
    "next-seo": "^6.8.0",
    "pinyin-pro": "^3.29.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.28",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.3.3",
    "next-sitemap": "^4.2.3"
  },
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "overrides": {
      "next>postcss": "8.5.31",
      "minimatch@9.0.3": "9.0.7",
      "yaml@2.7.0": "2.8.3"
    }
  },
  "engines": {
    "node": "22.x"
  }
}
